        d_moy:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the month of the year as a numerical value, supporting monthly aggregation of data.'),
        d_dom:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the day of the month, which is critical for daily and monthly reporting.'),
        d_qoy:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Denotes the quarter of the year, valuable for quarterly financial assessments and reviews.'),
        d_fy_year:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the fiscal year corresponding to the date, important for fiscal planning and analysis.'),
        d_fy_quarter_seq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the fiscal quarter sequence, essential for aligning financial reports with fiscal periods.'),
        d_fy_week_seq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Specifies the week number within the fiscal year, aiding in fiscal performance evaluation.'),
        d_day_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '9', description = 'Provides the name of the day, enhancing readability of date-related data. Sample values include "Saturday ", "Tuesday  ".'),
        d_quarter_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '6', description = 'Indicates the name of the quarter, useful for reporting on quarterly performance. Sample values include "1900Q1", "1900Q2".'),
        d_holiday:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates whether the date is a holiday, providing context for business operations. Sample values include "N".'),
        d_weekend:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Specifies if the date falls on a weekend, which is significant for operational planning. Sample values include "N", "Y".'),
        d_following_holiday:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates if there is a holiday following the date, useful for scheduling and planning purposes. Sample values include "N".'),
        d_first_dom:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the first day of the month, important for monthly report generation.'),
        d_last_dom:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the last day of the month, crucial for end-of-month reporting.'),
        d_same_day_ly:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the corresponding day in the previous year, vital for year-over-year comparisons.'),
        d_same_day_lq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the corresponding day in the last quarter, aiding in quarter-over-quarter analysis.'),
        d_current_day:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Specifies if the date is the current day, relevant for real-time data tracking. Sample values include "N".'),
        d_current_week:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates if the date is part of the current week, useful for week-specific analysis. Sample values include "N".'),
        d_current_month:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Specifies if the date falls within the current month, aiding in monthly assessments. Sample values include "N".'),
        d_current_quarter:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates if the date is within the current quarter, important for quarterly analysis. Sample values include "N".'),
        d_current_year:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Specifies if the date is within the current year, crucial for annual reporting. Sample values include "N".')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_date_dim view is a comprehensive date dimension table that organizes various date-related attributes into a structured format. It includes a unique identifier for each date entry, which ensures efficient data retrieval and organization. The table contains calendar dates, month sequences, week sequences, quarter sequences, and year indicators, which collectively facilitate trend analysis and reporting. Additional attributes like day of the week, month of the year, and fiscal year details enhance the usability of the data for various analytical purposes. Specific fields also denote holidays, weekends, and the current status of each date, providing context for operational planning and business analysis. This view could be used for time-based analysis, such as sales trends over specific periods, holiday effects on business operations, and fiscal reporting by aligning date-related data with financial performance metrics.'
