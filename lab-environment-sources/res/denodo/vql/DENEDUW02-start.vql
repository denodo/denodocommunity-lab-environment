        cc_sq_ft:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the total square footage of the call center, with values like "649" and "1138".'),
        cc_hours:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '20', description = 'Defines the operational hours of the call center, for instance, "8AM-4PM".'),
        cc_manager:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '40', description = 'Identifies the manager of the call center, with names such as "Bob Belcher" and "Larry Mccray".'),
        cc_mkt_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'References the marketing identifier associated with the call center, with examples like "2" and "6".'),
        cc_mkt_class:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Describes the marketing class related to the call center.'),
        cc_mkt_desc:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '100', description = 'Provides additional description for the marketing aspects of the call center.'),
        cc_market_manager:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '40', description = 'Denotes the market manager in charge, with names like "Julius Durham" and "Matthew Clifton".'),
        cc_division:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the division to which the call center belongs, represented by identifiers such as "1" and "3".'),
        cc_division_name:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '50', description = 'Specifies the name of the division, with examples including "ese" and "ought".'),
        cc_company:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'References the company associated with the call center, using identifiers like "2" and "3".'),
        cc_company_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Indicates the name of the company tied to the call center.'),
        cc_street_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Specifies the street number for the call center''s location, with examples like "463" and "730".'),
        cc_street_name:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '60', description = 'Identifies the name of the street where the call center is located, such as "Ash Hill" and "Center Hill".'),
        cc_street_type:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '15', description = 'Describes the type of street, with examples like "Boulevard" and "RD".'),
        cc_suite_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Specifies any suite number associated with the call center, with values like "Suite 0" and "Suite 70".'),
        cc_city:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '60', description = 'Indicates the city where the call center is based, such as "Midway".'),
        cc_county:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '30', description = 'Identifies the county in which the call center operates, e.g., "Williamson County".'),
        cc_state:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '2', description = 'Specifies the state where the call center is located, represented by abbreviations like "TN".'),
        cc_zip:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the ZIP code for the call center''s address, with an example of "31904".'),
        cc_country:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '20', description = 'Specifies the country of the call center''s location, indicated as "United States".'),
        cc_gmt_offset:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Represents the GMT offset for the call center''s location, such as "-5.00".'),
        cc_tax_percentage:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Indicates the tax percentage applicable to the call center, with examples like "0.01" and "0.05".')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_call_center view provides a comprehensive overview of call centers within a dataset. It includes key identifiers such as the unique call center key and ID, as well as operational details like the opening and closing dates, names, classes, and employee counts. The view captures geographical information, including street addresses, cities, counties, states, and ZIP codes, along with operational hours and tax percentages applicable to each center. This data is essential for analyzing the structure and performance of call centers, facilitating comparisons across various metrics. This view can be utilized for analyzing call center operations, performance metrics, and geographical distribution, aiding in decision-making for management and marketing strategies.'
