CREATE OR REPLACE VIEW store_by_total_sales FOLDER = '/4 - report views'
    PRIMARY KEY ( 'store_sk' ) AS SELECT iv_store.store_sk AS store_sk, sum(iv_store_sales.sales_price) AS total_sales FROM iv_store_sales AS iv_store_sales INNER JOIN iv_store AS iv_store ON iv_store_sales.store_sk = iv_store.store_sk  GROUP BY iv_store.store_sk ORDER BY total_sales DESC;

