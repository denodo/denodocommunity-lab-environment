        wp_web_page_id:text (notnull, sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '16', description = 'Identifies the web page with values like "AAAAAAAACAAAAAAA", "AAAAAAAAIAAAAAAA", and "AAAAAAAAOAAAAAAA".'),
        wp_rec_start_date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the date when the record became effective, providing context for data validity.'),
        wp_rec_end_date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypesize = '10', description = 'Specifies the end date for the record''s validity, marking when the data is no longer applicable.'),
        wp_creation_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Links to the date when the web page was created, essential for tracking content age.'),
