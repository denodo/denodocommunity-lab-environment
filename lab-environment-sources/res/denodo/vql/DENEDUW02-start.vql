        d_date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the actual calendar date, formatted for clarity and ease of use in analysis.'),
        d_month_seq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Denotes the sequential number of the month in the year, assisting in monthly trend analysis.'),
        d_week_seq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the sequential week number within the year, useful for weekly performance evaluations.'),
        d_quarter_seq:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the quarter sequence of the year, enabling quarterly business assessments and reporting.'),
        d_year:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the year corresponding to the date, facilitating annual reporting and historical comparisons.'),
