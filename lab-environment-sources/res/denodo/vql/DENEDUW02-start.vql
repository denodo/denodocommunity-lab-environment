        wp_autogen_flag:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates whether the web page was automatically generated, with values such as "N" and "Y".'),
        wp_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Refers to the identifier for the customer associated with the web page, facilitating user-centric analysis.'),
