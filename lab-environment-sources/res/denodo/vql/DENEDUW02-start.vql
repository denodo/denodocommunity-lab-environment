CREATE OR REPLACE TABLE bv_web_sales I18N us_pst (
        ws_sold_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique identifier for the date when sales occurred, facilitating tracking of sales trends over time.'),
        ws_sold_time_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the unique identifier for the time when sales transactions took place, allowing for detailed analysis of sales patterns throughout the day.'),
        ws_ship_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Serves as the unique identifier for the date on which products are shipped, essential for managing logistics and delivery timelines.'),
        ws_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies each product sold, providing insight into inventory management and sales performance of specific items.'),
        ws_bill_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique identifier for customers billed for the transaction, crucial for understanding customer demographics and billing patterns.'),
