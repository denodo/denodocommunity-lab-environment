CREATE OR REPLACE VIEW same_store_sales_by_year FOLDER = '/4 - report views'
    PRIMARY KEY ( 'year' , 'store_sk' ) AS SELECT bv_date_dim.d_year AS year, iv_store.store_sk AS store_sk, iv_store.store_name AS store_name, iv_store.city AS city, sum(iv_store_sales.sales_price) AS total_sales FROM (iv_store_sales AS iv_store_sales INNER JOIN bv_date_dim AS bv_date_dim ON iv_store_sales.sold_date_sk = bv_date_dim.d_date_sk ) INNER JOIN iv_store AS iv_store ON iv_store_sales.store_sk = iv_store.store_sk  GROUP BY bv_date_dim.d_year, iv_store.store_sk, iv_store.store_name, iv_store.city;

