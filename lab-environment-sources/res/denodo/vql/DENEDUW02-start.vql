        cc_call_center_id:text (notnull, sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '16', description = 'Identifies the call center with unique values such as "AAAAAAAABAAAAAAA" and "AAAAAAAACAAAAAAA".'),
