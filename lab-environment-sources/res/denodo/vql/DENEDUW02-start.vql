        c_first_sales_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the date of the customer''s initial purchase, which helps in analyzing customer loyalty and engagement over time.'),
        c_salutation:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the salutation of the customer, such as "Mr." or "Sir", contributing to personalized communication. Sample values include "Mr.", "Sir".'),
        c_first_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '20', description = 'Captures the customer''s first name, crucial for personalized interactions. Sample values include "Nathan", "Paul", "Robert".'),
        c_last_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '30', description = 'Records the last name of the customer, important for identification purposes. Sample values include "Higgins", "Moran", "Pond".'),
        c_preferred_cust_flag:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '1', description = 'Indicates whether the customer is preferred, influencing how they are targeted in marketing efforts. Sample values include "N", "Y".'),
        c_birth_day:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the day of birth of the customer, essential for age verification and targeted marketing campaigns.'),
