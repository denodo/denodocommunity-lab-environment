        web_close_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the date key when the website was closed, documenting its shutdown.'),
        web_class:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '50', description = 'Describes the classification of the website, currently noted as "Unknown".'),
        web_manager:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '40', description = 'Identifies the manager responsible for the website, including names like "Dwight Aaron" and "Harold Wilson".'),
        web_mkt_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents the marketing identifier associated with the website.'),
        web_mkt_class:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '50', description = 'Defines the marketing class of the website, with examples such as "Hard new suggestions might contain nat".'),
        web_mkt_desc:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '100', description = 'Provides a description of the marketing strategy employed, such as "Companies grow cells. Apart true eyes u".'),
        web_market_manager:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '40', description = 'Names the manager overseeing the market activities of the website, with examples like "Albert Leung" and "Frank Cooper".'),
        web_company_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the identifier for the company owning the website.'),
        web_company_name:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Specifies the name of the company, though currently no values are provided.'),
        web_street_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Details the street number for the website''s physical address, such as "409", "805", and "841".'),
        web_street_name:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '60', description = 'Mention the street name, including examples like "Hill Hill", "Lake ", and "West Cedar".'),
        web_street_type:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '15', description = 'Describes the type of street, with examples such as "Blvd", "Ct.", and "Dr.". '),
        web_suite_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the suite number as part of the address, with values like "Suite 370" and "Suite D".'),
        web_city:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '60', description = 'Refers to the city where the website''s physical presence is located, currently "Midway".'),
        web_county:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '30', description = 'Specifies the county associated with the website''s address, noted as "Williamson County".'),
        web_state:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '2', description = 'Indicates the state where the site operates, currently "TN".'),
        web_zip:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Provides the zip code for the website''s location, noted as "31904".'),
        web_country:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '20', description = 'Identifies the country of operation, listed as "United States".'),
        web_gmt_offset:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Specifies the GMT offset for the website''s operational time zone.'),
        web_tax_percentage:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Indicates the tax percentage applicable to the website''s transactions.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_web_site view provides a comprehensive repository of information regarding various websites. Each entry is uniquely identified by a key and includes fields that capture essential attributes such as website ID, name, operational dates (both start and end), classifications, and management details. The view contains specific data points like the street address, city, county, state, zip code, and country where the website operates. Additionally, it outlines marketing-related identifiers and strategies associated with each website, allowing for a detailed understanding of the website''s market presence and operational dynamics. The bv_web_site view can be utilized for analyzing website activity, tracking website management, and understanding the geographical distribution and marketing strategies of various websites.'
    PRIMARY KEY ( 'web_site_sk' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_web_site(
        I18N us_pst
        CONSTRAINTS (
             ADD web_site_sk (any) OPT ANY
             ADD web_site_id (any) OPT ANY
             ADD web_rec_start_date (any) OPT ANY
             ADD web_rec_end_date (any) OPT ANY
             ADD web_name (any) OPT ANY
             ADD web_open_date_sk (any) OPT ANY
             ADD web_close_date_sk (any) OPT ANY
             ADD web_class (any) OPT ANY
             ADD web_manager (any) OPT ANY
             ADD web_mkt_id (any) OPT ANY
             ADD web_mkt_class (any) OPT ANY
             ADD web_mkt_desc (any) OPT ANY
             ADD web_market_manager (any) OPT ANY
             ADD web_company_id (any) OPT ANY
             ADD web_company_name (any) OPT ANY
             ADD web_street_number (any) OPT ANY
             ADD web_street_name (any) OPT ANY
             ADD web_street_type (any) OPT ANY
             ADD web_suite_number (any) OPT ANY
             ADD web_city (any) OPT ANY
             ADD web_county (any) OPT ANY
             ADD web_state (any) OPT ANY
             ADD web_zip (any) OPT ANY
             ADD web_country (any) OPT ANY
             ADD web_gmt_offset (any) OPT ANY
             ADD web_tax_percentage (any) OPT ANY
        )
        OUTPUTLIST (web_city, web_class, web_close_date_sk, web_company_id, web_company_name, web_country, web_county, web_gmt_offset, web_manager, web_market_manager, web_mkt_class, web_mkt_desc, web_mkt_id, web_name, web_open_date_sk, web_rec_end_date, web_rec_start_date, web_site_id, web_site_sk, web_state, web_street_name, web_street_number, web_street_type, web_suite_number, web_tax_percentage, web_zip
        )
        WRAPPER (jdbc bv_web_site)
    );

CHOWN admin VIEW bv_web_site LASTMODIFICATIONUSER admin;

# #######################################
# VIEWS of denodo_hol
# #######################################
CREATE OR REPLACE VIEW iv_catalog_sales FOLDER = '/2 - integration' DESCRIPTION = 'The iv_catalog_sales view provides a detailed overview of sales transactions, capturing essential information such as the dates and times when sales occurred, shipping details, customer billing information, and product specifics. Each entry includes crucial identifiers for customers, addresses, call centers, and items sold, along with metrics like quantity sold, list prices, and sales prices. This view serves as a comprehensive resource for tracking sales performance, managing inventory, and analyzing sales trends over time. This view can be used for analyzing sales performance, tracking customer transactions, and improving inventory management.' 
    PRIMARY KEY ( 'item_sk' , 'order_number' ) AS SELECT bv_catalog_sales.cs_sold_date_sk AS sold_date_sk, bv_catalog_sales.cs_sold_time_sk AS sold_time_sk, bv_catalog_sales.cs_ship_date_sk AS ship_date_sk, bv_catalog_sales.cs_bill_customer_sk AS bill_customer_sk, bv_catalog_sales.cs_bill_addr_sk AS bill_addr_sk, bv_catalog_sales.cs_ship_customer_sk AS ship_customer_sk, bv_catalog_sales.cs_ship_addr_sk AS ship_addr_sk, bv_catalog_sales.cs_call_center_sk AS call_center_sk, bv_catalog_sales.cs_catalog_page_sk AS catalog_page_sk, bv_catalog_sales.cs_warehouse_sk AS warehouse_sk, bv_catalog_sales.cs_item_sk AS item_sk, bv_catalog_sales.cs_order_number AS order_number, bv_catalog_sales.cs_quantity AS quantity, bv_catalog_sales.cs_list_price AS list_price, bv_catalog_sales.cs_sales_price AS sales_price FROM bv_catalog_sales;

CHOWN admin VIEW iv_catalog_sales LASTMODIFICATIONUSER admin;

ALTER VIEW iv_catalog_sales
 LAYOUT (bv_catalog_sales = [20, 20, 200, 105]);

CREATE OR REPLACE VIEW iv_customer FOLDER = '/2 - integration' DESCRIPTION = 'The iv_customer view represents a comprehensive dataset containing detailed information about customers. It features a unique identifier for each customer, known as customer_sk, which is essential for distinguishing individual records within the customer database. Additionally, it includes customer_id, a unique identification code that maps to each customer. The view offers insights into customers'' current addresses, first names, last names, and preferred customer status, which indicates their importance in marketing strategies. Furthermore, it captures demographic information such as birth days, months, years, and countries, which are vital for targeted marketing campaigns and understanding geographic demographics. The iv_customer view also facilitates account access and security by logging customers'' login information and storing their email addresses, serving as a key communication channel. This view can be used for customer segmentation, targeted marketing campaigns, and personalized communication strategies based on demographic data and customer preferences.' 
    PRIMARY KEY ( 'customer_sk' ) AS SELECT bv_customer.c_customer_sk AS customer_sk, bv_customer.c_customer_id AS customer_id, bv_customer.c_current_addr_sk AS current_addr_sk, bv_customer.c_first_name AS first_name, bv_customer.c_last_name AS last_name, bv_customer.c_preferred_cust_flag AS preferred_cust_flag, bv_customer.c_birth_day AS birth_day, bv_customer.c_birth_month AS birth_month, bv_customer.c_birth_year AS birth_year, bv_customer.c_birth_country AS birth_country, bv_customer.c_login AS login, bv_customer.c_email_address AS email_address FROM bv_customer WHERE (c_first_name is not null  AND c_current_addr_sk is not null );

CHOWN admin VIEW iv_customer LASTMODIFICATIONUSER admin;

ALTER VIEW iv_customer
 LAYOUT (bv_customer = [20, 20, 262, 385]);

CREATE OR REPLACE VIEW iv_customer_address FOLDER = '/2 - integration' DESCRIPTION = 'The iv_customer_address view provides a comprehensive representation of customer addresses within the database. It includes several fields that capture important details about each address, such as a unique identifier for the address entry, alphanumeric address IDs, street numbers, street names, and the type of street. Additionally, the view specifies the city, county, state, ZIP code, and country associated with each address, ensuring a clear understanding of the location. For example, addresses such as "576 4th Avenue, Sumner, Clark County, MO, 20519, United States" exemplify the structured information contained within this view. This view could be utilized for managing and retrieving customer address information efficiently, aiding in tasks such as shipping, location-based services, and demographic analysis.' 
    PRIMARY KEY ( 'address_sk' ) AS SELECT bv_customer_address.ca_address_sk AS address_sk, bv_customer_address.ca_address_id AS address_id, bv_customer_address.ca_street_number AS street_number, bv_customer_address.ca_street_name AS street_name, bv_customer_address.ca_street_type AS street_type, bv_customer_address.ca_city AS city, bv_customer_address.ca_county AS county, bv_customer_address.ca_state AS state, bv_customer_address.ca_zip AS zip, bv_customer_address.ca_country AS country FROM bv_customer_address WHERE ca_state is not null ;

CHOWN admin VIEW iv_customer_address LASTMODIFICATIONUSER admin;

ALTER VIEW iv_customer_address
 LAYOUT (bv_customer_address = [20, 20, 200, 105]);

CREATE OR REPLACE VIEW iv_inventory FOLDER = '/2 - integration' DESCRIPTION = 'The iv_inventory view provides a comprehensive overview of inventory records, capturing essential details such as the date of the inventory entry, unique item identifiers, warehouse locations, and the quantity of items on hand. It effectively reflects the dynamics of stock levels over time, allowing businesses to analyze inventory trends and make informed decisions regarding stock management. The fields included are designed to facilitate precise tracking and management of inventory across various warehouses, providing critical insights into inventory distribution and availability. This view can be used for monitoring stock levels, analyzing inventory trends over time, and aiding in effective inventory management and logistics planning.' 
    PRIMARY KEY ( 'date_sk' , 'item_sk' , 'warehouse_sk' ) AS SELECT bv_inventory.inv_date_sk AS date_sk, bv_inventory.inv_item_sk AS item_sk, bv_inventory.inv_warehouse_sk AS warehouse_sk, bv_inventory.inv_quantity_on_hand AS quantity_on_hand FROM bv_inventory;

CHOWN admin VIEW iv_inventory LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_item FOLDER = '/2 - integration' DESCRIPTION = 'The iv_item view provides a comprehensive overview of items within an inventory system, characterized by a unique identifier (item_sk) for each item, allowing for effective tracking and management. It includes various attributes such as item_id, which serves as a secondary unique identifier, and current_price, reflecting the selling price of items. Additional fields such as brand_id and brand help to identify the brand associated with each item, while class_id and class facilitate categorization. The view also captures details about the item''s category through category_id and category, along with manufacturing details indicated by manufact_id and manufact. Furthermore, it describes physical characteristics such as size and color, with units indicating the measurement used for the items. The inclusion of actual field values offers practical examples, enriching the understanding of the inventory''s composition. The iv_item view could be used for managing inventory, tracking product details, and analyzing sales data based on item attributes.' 
    PRIMARY KEY ( 'item_sk' ) AS SELECT bv_item.i_item_sk AS item_sk, bv_item.i_item_id AS item_id, bv_item.i_current_price AS current_price, bv_item.i_brand_id AS brand_id, bv_item.i_brand AS brand, bv_item.i_class_id AS class_id, bv_item.i_class AS class, bv_item.i_category_id AS category_id, bv_item.i_category AS category, bv_item.i_manufact_id AS manufact_id, bv_item.i_manufact AS manufact, bv_item.i_size AS size, bv_item.i_color AS color, bv_item.i_units AS units FROM bv_item;

CHOWN admin VIEW iv_item LASTMODIFICATIONUSER admin;

ALTER VIEW iv_item
 LAYOUT (bv_item = [20, 20, 200, 105]);

CREATE OR REPLACE VIEW iv_store FOLDER = '/2 - integration' DESCRIPTION = 'The iv_store view provides a comprehensive overview of store-related data, including unique identifiers, names, and operational details. It features fields such as store_sk, a unique identifier crucial for tracking stores, and store_name, which reflects the brand identity of the store. Additional attributes include the number of employees, total floor space, operating hours, and managerial details. The view also encompasses location-specific data, including street number, street name, city, county, state, ZIP code, and country, offering a complete picture of each store''s operational footprint. The iv_store view can be utilized for analyzing store performance, managing inventory, and optimizing operations across various locations. It serves as a vital resource for decision-making processes related to store management and performance evaluation.' 
    PRIMARY KEY ( 'store_sk' ) AS SELECT bv_store.s_store_sk AS store_sk, bv_store.s_store_id AS store_id, bv_store.s_store_name AS store_name, bv_store.s_number_employees AS number_employees, bv_store.s_floor_space AS floor_space, bv_store.s_hours AS hours, bv_store.s_manager AS manager, bv_store.s_street_number AS street_number, bv_store.s_street_name AS street_name, bv_store.s_street_type AS street_type, bv_store.s_suite_number AS suite_number, bv_store.s_city AS city, bv_store.s_county AS county, bv_store.s_state AS state, bv_store.s_zip AS zip, bv_store.s_country AS country FROM bv_store;

CHOWN admin VIEW iv_store LASTMODIFICATIONUSER admin;

ALTER VIEW iv_store
 LAYOUT (bv_store = [20, 20, 200, 105]);

CREATE OR REPLACE VIEW iv_store_sales FOLDER = '/2 - integration' DESCRIPTION = 'The iv_store_sales view provides a comprehensive overview of sales transactions, capturing essential details about each sale made in a retail environment. It includes fields that track the date and time of sales, allowing for temporal analysis, and identifies specific items sold, which is crucial for inventory management. The view also links to customer information and addresses, facilitating insights into customer behavior and geographic trends. Each transaction is uniquely identified by a ticket number, and key metrics such as quantity sold, list price, and sales price are included, enabling detailed revenue and performance assessments across different stores. This view can be used for analyzing sales performance over time, understanding customer purchasing behaviors, optimizing inventory management, and evaluating the effectiveness of pricing strategies.' 
    PRIMARY KEY ( 'item_sk' , 'ticket_number' ) AS SELECT bv_store_sales.ss_sold_date_sk AS sold_date_sk, bv_store_sales.ss_sold_time_sk AS sold_time_sk, bv_store_sales.ss_item_sk AS item_sk, bv_store_sales.ss_customer_sk AS customer_sk, bv_store_sales.ss_addr_sk AS addr_sk, bv_store_sales.ss_store_sk AS store_sk, bv_store_sales.ss_ticket_number AS ticket_number, bv_store_sales.ss_quantity AS quantity, bv_store_sales.ss_list_price AS list_price, bv_store_sales.ss_sales_price AS sales_price FROM bv_store_sales;

CHOWN admin VIEW iv_store_sales LASTMODIFICATIONUSER admin;

ALTER VIEW iv_store_sales
 LAYOUT (bv_store_sales = [20, 20, 289, 485]);

CREATE OR REPLACE VIEW iv_warehouse FOLDER = '/2 - integration' DESCRIPTION = 'The iv_warehouse view provides detailed information about various warehouse entries. Each entry is identified by a unique warehouse_sk, which serves as the primary key, ensuring distinct records are maintained. Additional fields include warehouse_id, which contains specific identifiers for each warehouse; warehouse_name, which gives the names of the warehouses; and warehouse_sq_ft, indicating their sizes in square feet. The view also details the location of each warehouse with fields such as street_number, street_name, street_type, suite_number, city, county, state, zip, and country. Furthermore, it includes gmt_offset, which specifies the time zone offset for the warehouse''s location. This view could be used for managing warehouse logistics, tracking warehouse locations, and analyzing warehouse sizes and identifiers for operational efficiency.' 
    PRIMARY KEY ( 'warehouse_sk' ) AS SELECT bv_warehouse.w_warehouse_sk AS warehouse_sk, bv_warehouse.w_warehouse_id AS warehouse_id, bv_warehouse.w_warehouse_name AS warehouse_name, bv_warehouse.w_warehouse_sq_ft AS warehouse_sq_ft, bv_warehouse.w_street_number AS street_number, bv_warehouse.w_street_name AS street_name, bv_warehouse.w_street_type AS street_type, bv_warehouse.w_suite_number AS suite_number, bv_warehouse.w_city AS city, bv_warehouse.w_county AS county, bv_warehouse.w_state AS state, bv_warehouse.w_zip AS zip, bv_warehouse.w_country AS country, bv_warehouse.w_gmt_offset AS gmt_offset FROM bv_warehouse;

CHOWN admin VIEW iv_warehouse LASTMODIFICATIONUSER admin;

ALTER VIEW iv_warehouse
 LAYOUT (bv_warehouse = [20, 20, 200, 105]);

CREATE OR REPLACE VIEW iv_web_sales FOLDER = '/2 - integration' DESCRIPTION = 'The iv_web_sales view captures detailed information about web-based sales transactions. It includes various fields such as the unique identifiers for the dates and times when sales occurred, along with identifiers for items sold, customers billed, shipping addresses, and payment methods. This comprehensive view also tracks details regarding the web pages and websites involved in the sales, shipping modes, and warehouse identifiers, thereby facilitating in-depth analysis of sales trends, customer behavior, and logistics management. The presence of both list and sales prices allows for effective pricing strategy assessments and revenue analysis. This view can be utilized for analyzing sales trends over time, understanding customer demographics, and evaluating the performance of online sales channels, logistics management, and pricing strategies.' 
    PRIMARY KEY ( 'item_sk' , 'order_number' ) AS SELECT bv_web_sales.ws_sold_date_sk AS sold_date_sk, bv_web_sales.ws_sold_time_sk AS sold_time_sk, bv_web_sales.ws_ship_date_sk AS ship_date_sk, bv_web_sales.ws_item_sk AS item_sk, bv_web_sales.ws_bill_customer_sk AS bill_customer_sk, bv_web_sales.ws_bill_addr_sk AS bill_addr_sk, bv_web_sales.ws_ship_customer_sk AS ship_customer_sk, bv_web_sales.ws_ship_addr_sk AS ship_addr_sk, bv_web_sales.ws_web_page_sk AS web_page_sk, bv_web_sales.ws_web_site_sk AS web_site_sk, bv_web_sales.ws_ship_mode_sk AS ship_mode_sk, bv_web_sales.ws_warehouse_sk AS warehouse_sk, bv_web_sales.ws_order_number AS order_number, bv_web_sales.ws_quantity AS quantity, bv_web_sales.ws_list_price AS list_price, bv_web_sales.ws_sales_price AS sales_price FROM bv_web_sales;

CHOWN admin VIEW iv_web_sales LASTMODIFICATIONUSER admin;

ALTER VIEW iv_web_sales
 LAYOUT (bv_web_sales = [20, 20, 306, 474]);

CREATE OR REPLACE VIEW holiday_web_sales_by_year FOLDER = '/4 - report views' DESCRIPTION = 'The holiday_web_sales_by_year view provides a structured representation of annual online sales data. It includes two key fields: the year, which indicates the specific calendar year, and total_sales, which reflects the overall sales figures for that year. This view enables businesses to track their sales performance over different years, facilitating historical comparisons and annual reporting. This view can be used for analyzing trends in annual sales, evaluating business performance over time, and making informed decisions based on historical sales data.' 
    PRIMARY KEY ( 'year' ) (
    total_sales (description = 'Represents the cumulative sales figures for the specified year, providing insights into business performance over time.')
 )
 AS SELECT bv_date_dim.d_year AS year, sum(iv_web_sales.sales_price) AS total_sales FROM iv_web_sales AS iv_web_sales INNER JOIN bv_date_dim AS bv_date_dim ON iv_web_sales.sold_date_sk = bv_date_dim.d_date_sk  WHERE bv_date_dim.d_holiday = 'Y' GROUP BY bv_date_dim.d_year;

ALTER VIEW holiday_web_sales_by_year
 LAYOUT (iv_web_sales = [90, 230, 200, 225], bv_date_dim = [510, 60, 200, 225]);

CHOWN admin VIEW holiday_web_sales_by_year LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_customer_j_address FOLDER = '/2 - integration' DESCRIPTION = 'The iv_customer_j_address view provides a comprehensive representation of customer address information, capturing key details necessary for effective communication and service delivery. Each record is uniquely identified by the customer_sk, which serves as a vital reference for distinguishing individual customers within the database. The view includes fields such as customer_id, first_name, and last_name, enabling personalized interactions with customers. Important demographic information is also included, such as birth_day, birth_month, birth_year, and birth_country, which can assist in targeted marketing efforts based on age and geographic data. Additionally, the view stores essential address details, including street_number, street_name, city, county, state, zip, and country, ensuring accurate location information for all customers. The inclusion of flags like preferred_cust_flag indicates customer preferences, which can inform marketing strategies and customer relationship management initiatives. The iv_customer_j_address view can be utilized for customer relationship management (CRM) purposes, enabling businesses to personalize marketing strategies, improve customer service, and accurately target customers based on demographic and geographic information.' 
    PRIMARY KEY ( 'customer_sk' ) AS SELECT iv_customer.customer_sk AS customer_sk, iv_customer.customer_id AS customer_id, iv_customer.current_addr_sk AS current_addr_sk, iv_customer.first_name AS first_name, iv_customer.last_name AS last_name, iv_customer.preferred_cust_flag AS preferred_cust_flag, iv_customer.birth_day AS birth_day, iv_customer.birth_month AS birth_month, iv_customer.birth_year AS birth_year, iv_customer.birth_country AS birth_country, iv_customer.login AS login, iv_customer.email_address AS email_address, iv_customer_address.address_sk AS address_sk, iv_customer_address.address_id AS address_id, iv_customer_address.street_number AS street_number, iv_customer_address.street_name AS street_name, iv_customer_address.street_type AS street_type, iv_customer_address.city AS city, iv_customer_address.county AS county, iv_customer_address.state AS state, iv_customer_address.zip AS zip, iv_customer_address.country AS country FROM iv_customer AS iv_customer INNER JOIN iv_customer_address AS iv_customer_address ON iv_customer.current_addr_sk = iv_customer_address.address_sk ;

ALTER VIEW iv_customer_j_address
 LAYOUT (iv_customer = [150, 40, 200, 225], iv_customer_address = [460, 40, 200, 225]);

CHOWN admin VIEW iv_customer_j_address LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW same_store_sales_by_year FOLDER = '/4 - report views' DESCRIPTION = 'The same_store_sales_by_year view presents data on the annual sales performance of specific stores. It includes fields such as the year, a unique store identifier, the name of the store, the city where the store is located, and total sales figures. This information is structured to facilitate comparisons of sales performance over the years, allowing for insights into trends and growth in specific locations. This view could be used for analyzing sales trends over time, assessing the performance of different stores, and making data-driven decisions related to marketing and inventory management.' 
    PRIMARY KEY ( 'year' , 'store_sk' ) (
    total_sales (description = 'Represents the total sales figures for each store, providing insights into financial performance and trends over time.')
 )
 AS SELECT bv_date_dim.d_year AS year, iv_store.store_sk AS store_sk, iv_store.store_name AS store_name, iv_store.city AS city, sum(iv_store_sales.sales_price) AS total_sales FROM (iv_store_sales AS iv_store_sales INNER JOIN bv_date_dim AS bv_date_dim ON iv_store_sales.sold_date_sk = bv_date_dim.d_date_sk ) INNER JOIN iv_store AS iv_store ON iv_store_sales.store_sk = iv_store.store_sk  GROUP BY bv_date_dim.d_year, iv_store.store_sk, iv_store.store_name, iv_store.city;

ALTER VIEW same_store_sales_by_year
 LAYOUT (iv_store_sales = [20, 20, 200, 225], bv_date_dim = [20, 275, 200, 225], iv_store = [20, 530, 200, 225]);

CHOWN admin VIEW same_store_sales_by_year LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW store_by_total_sales FOLDER = '/4 - report views' DESCRIPTION = 'The store_by_total_sales view provides an overview of sales data across different stores, represented by a unique store identifier (store_sk) and the corresponding total sales amount (total_sales). This view is designed to facilitate the analysis of store performance based on total sales figures, making it an essential tool for evaluating the financial outcomes of individual stores. This view can be utilized for assessing the sales performance of each store, identifying trends in sales data, and making informed business decisions regarding inventory, marketing strategies, and operational improvements.' 
    PRIMARY KEY ( 'store_sk' ) (
    total_sales (description = 'Indicates the overall sales amount for each store, providing essential insight into the financial performance of the stores. This metric is vital for evaluating business outcomes and identifying sales trends, assisting decision-makers in strategic planning.')
 )
 AS SELECT iv_store.store_sk AS store_sk, sum(iv_store_sales.sales_price) AS total_sales FROM iv_store_sales AS iv_store_sales INNER JOIN iv_store AS iv_store ON iv_store_sales.store_sk = iv_store.store_sk  GROUP BY iv_store.store_sk ORDER BY total_sales DESC;

ALTER VIEW store_by_total_sales
 LAYOUT (iv_store_sales = [110, 120, 200, 225], iv_store = [500, 130, 200, 225]);

CHOWN admin VIEW store_by_total_sales LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW total_sales_by_customer_and_store FOLDER = '/4 - report views' DESCRIPTION = 'The total_sales_by_customer_and_store view provides a detailed overview of sales transactions categorized by individual customers and the stores where these transactions took place. It includes essential fields such as a unique customer identifier, their first and last names for personalized engagement, and detailed address information, including street number, street name, city, county, state, ZIP code, and country. Additionally, the view captures the store identifier where each sale occurred and the total price of the sale. This structured data allows for comprehensive analysis and understanding of sales patterns across different customers and stores. This view could be used for analyzing customer purchasing behavior across various store locations, assessing store performance, and tailoring marketing strategies based on customer demographics and sales data.' 
    PRIMARY KEY ( 'customer_sk' , 'store_sk' ) (
    total_price (description = 'Represents the total price of the sale, providing insight into transaction values.')
 )
 AS 
    SELECT iv_customer_j_address.customer_sk AS customer_sk,
           iv_customer_j_address.first_name AS first_name,
           iv_customer_j_address.last_name AS last_name,
           iv_customer_j_address.street_number AS street_number,
           iv_customer_j_address.street_name AS street_name,
           iv_customer_j_address.street_type AS street_type,
           iv_customer_j_address.city AS city,
           iv_customer_j_address.county AS county,
           iv_customer_j_address.state AS state,
           iv_customer_j_address.zip AS zip,
           iv_customer_j_address.country AS country,
           iv_store_sales.store_sk AS store_sk,
           sum(iv_store_sales.sales_price) AS total_price
    FROM iv_customer_j_address AS iv_customer_j_address
         INNER JOIN iv_store_sales AS iv_store_sales
             ON iv_customer_j_address.customer_sk = iv_store_sales.customer_sk
    WHERE iv_customer_j_address.state <> ''
    GROUP BY iv_customer_j_address.customer_sk,
             iv_customer_j_address.first_name,
             iv_customer_j_address.last_name,
             iv_customer_j_address.street_number,
             iv_customer_j_address.street_name,
             iv_customer_j_address.street_type,
             iv_customer_j_address.city,
             iv_customer_j_address.county,
             iv_customer_j_address.state,
             iv_customer_j_address.zip,
             iv_customer_j_address.country,
             iv_store_sales.store_sk;

ALTER VIEW total_sales_by_customer_and_store
 LAYOUT (iv_customer_j_address = [220, 130, 200, 225], iv_store_sales = [540, 130, 200, 225]);

CHOWN admin VIEW total_sales_by_customer_and_store LASTMODIFICATIONUSER admin;

# #######################################
# METRICS of denodo_hol
# #######################################

CREATE OR REPLACE METRIC VIEW mv_store_sales_analysis
    FOLDER = '/4 - report views'
    DESCRIPTION = 'Metric view summarizing store sales performance across dimensions.' 
     (
    total_sales_amount (description = 'Represents the total sales revenue generated, a critical metric for assessing overall financial performance.'),
    total_units_sold (description = 'Indicates the total number of units sold, essential for inventory planning and operational efficiency.'),
    average_sales_price (description = 'Calculates the average price at which products were sold, providing insights into pricing strategy and market positioning.'),
    total_net_profit (description = 'Sum of net profits from sales, highlighting profitability and financial health of the store.')
 )
SOURCES (
        item AS bv_item,
        date_dim AS bv_date_dim,
        store AS bv_store,
        sales AS bv_store_sales    
    )
    ASSOCIATIONS (
        sales store bv_store_bv_store_sales RIGHT,
        sales date_dim bv_date_dim_bv_store_sales RIGHT,
        sales item bv_item_bv_store_sales RIGHT    
    )
    DIMENSIONS (
        time_dim(
            sales_year AS date_dim.d_year,
            quarter_name AS date_dim.d_quarter_name
        ),
        location_dim(
            store_name AS store.s_store_name,
            city AS store.s_city,
            state AS store.s_state
        ),
        product_category AS item.i_category    
    )
    METRICS (
        total_sales_amount AS sum(sales.ss_sales_price),
        total_units_sold AS sum(sales.ss_quantity),
        average_sales_price AS avg(sales.ss_sales_price),
        total_net_profit AS sum(sales.ss_net_profit)    
    )
;

ALTER VIEW mv_store_sales_analysis
 LAYOUT (bv_store_sales = [262, 273, 40, 80], bv_store = [879, 206, 40, 80], bv_date_dim = [593, 126, 40, 80], bv_item = [750, 408, 40, 80]);


