CREATE OR REPLACE TABLE bv_inventory I18N us_pst (
        inv_date_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the specific date associated with the inventory record, allowing for tracking and management of stock levels over time. It reflects the day on which the inventory details were recorded, facilitating historical analysis of inventory trends.'),
        inv_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents the unique identifier for each item in the inventory, enabling precise tracking of stock across various warehouses. This field is essential for inventory management as it links items to their respective details and facilitates effective inventory planning.'),
        inv_warehouse_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Identifies the specific warehouse where the inventory is stored, providing crucial information for logistics and supply chain management. This field helps in understanding inventory distribution and aids in optimizing warehouse operations.'),
        inv_quantity_on_hand:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the quantity of items currently available in stock, which is vital for inventory control and forecasting. This field helps businesses assess stock levels to prevent shortages and manage restocking effectively.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_inventory view provides a comprehensive overview of inventory records, detailing essential data points such as the specific date associated with each inventory entry, a unique identifier for each item, the warehouse location where the inventory is stored, and the quantity of each item currently on hand. This structured representation is crucial for effective inventory management, enabling businesses to track stock levels over time, manage logistics efficiently, and optimize supply chain operations. The date field allows for historical analysis, while the warehouse and item identifiers facilitate precise tracking and planning of inventory. The bv_inventory view can be used for inventory management, logistics optimization, and stock level forecasting, enabling businesses to make informed decisions regarding inventory control and supply chain strategies.'
