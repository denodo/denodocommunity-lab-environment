        i_current_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Shows the current selling price of the item, with examples including "0.50", "2.42", and "98.66".'),
        i_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the cost price at which the item is purchased, with values such as "0.22", "0.87", and "85.83".'),
        i_brand_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Identifies the brand of the item, with examples like "2001002", "6012007", and "10006011".'),
        i_brand:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Indicates the brand name associated with the item, enhancing brand recognition.'),
        i_class_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents the classification code for the item, which helps in categorizing the inventory.'),
        i_class:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Describes the class to which the item belongs, aiding in its classification.'),
        i_category_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Identifies the category of the item, facilitating organization and retrieval.'),
        i_category:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Specifies the category name for the item, which is essential for inventory categorization.'),
        i_manufact_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents the unique identifier for the manufacturer of the item, such as "252", "489", and "785".'),
        i_manufact:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '50', description = 'Indicates the manufacturer''s name, providing insight into the source of the product.'),
        i_size:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '20', description = 'Represents the size of the item, with examples like "N/A" and "petite".'),
        i_formulation:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '20', description = 'Describes the formulation of the item, with instances such as "115838salmon36529828" and "83227powder377577506".'),
        i_color:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '20', description = 'Specifies the color of the item, including hues like "gainsboro" and "rose".'),
