CREATE OR REPLACE TABLE bv_catalog_sales I18N us_pst (
        cs_sold_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the date on which the sale occurred, providing a key reference for sales tracking and analysis.'),
        cs_sold_time_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the specific time when the sale was finalized, allowing for precise temporal analysis of sales activities.'),
        cs_ship_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Denotes the date when the order was shipped, which is crucial for evaluating delivery timelines and customer satisfaction.'),
        cs_bill_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the customer who was billed for the transaction, essential for billing relationships and customer account management.'),
        cs_bill_cdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'References a demographic profile related to the billed customer, aiding in understanding customer characteristics and preferences.'),
        cs_bill_hdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to household demographic information of the billing customer, providing insights into household behavior and trends.'),
        cs_bill_addr_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Points to the billing address, which is important for shipping, invoicing, and tax calculations.'),
        cs_ship_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the customer to whom the product was shipped, important for tracking customer satisfaction and delivery success.'),
        cs_ship_cdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to the demographic profile of the shipping customer, useful for market analysis and targeted marketing strategies.'),
        cs_ship_hdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Associates with household demographic data for the shipping customer, enriching customer profile insights.'),
        cs_ship_addr_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the shipping address for the order, critical for ensuring accurate and timely deliveries.'),
        cs_call_center_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the call center associated with the order, important for customer service and support purposes.'),
        cs_catalog_page_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the catalog page associated with the item sold, useful for analyzing product placements and marketing effectiveness.'),
        cs_ship_mode_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the shipping mode used for the delivery, helping assess logistics efficiency and cost management.'),
        cs_warehouse_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Points to the warehouse from which the product was shipped, essential for inventory management and supply chain operations.'),
        cs_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Uniquely identifies the item sold, essential for inventory tracking and sales reporting.'),
        cs_promo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to promotional details associated with the sale, important for analyzing marketing effectiveness.'),
        cs_order_number:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the order number for the sale, which is crucial for order tracking and customer service interactions.'),
        cs_quantity:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Specifies the quantity of items sold, key for inventory management and sales performance analysis.'),
        cs_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the cost at which items were purchased, essential for calculating profit margins.'),
        cs_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the standard price of the item before any discounts or promotions, important for pricing strategies.'),
        cs_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Denotes the actual sale price of the item after any applicable discounts, critical for revenue analysis.'),
        cs_ext_discount_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Details the total discount applied to the sale, important for understanding discounting strategies.'),
        cs_ext_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the extended sales price of the order, providing a total revenue figure for analysis.'),
        cs_ext_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total wholesale cost for the items sold, critical for evaluating overall profitability.'),
        cs_ext_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Denotes the total list price for the order, useful for assessing pricing strategies and potential revenue.'),
        cs_ext_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the amount of tax applied to the sale, critical for accounting and compliance purposes.'),
        cs_coupon_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total amount of any coupons applied to the sale, important for promotional analysis.'),
        cs_ext_ship_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total cost of shipping for the order, important for logistics and customer pricing transparency.'),
        cs_net_paid:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the final amount paid by the customer after all adjustments, key for financial reporting.'),
        cs_net_paid_inc_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the net amount paid including tax, essential for understanding the total customer expenditure.'),
        cs_net_paid_inc_ship:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total amount paid including shipping costs, important for full cost transparency.'),
        cs_net_paid_inc_ship_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Denotes the total amount paid including shipping and tax, crucial for comprehensive financial analysis.'),
        cs_net_profit:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the profit made from the sale after all expenses, critical for assessing business performance.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_catalog_sales view encapsulates detailed information regarding sales transactions, including dates, times, customer details, shipping modes, and financial metrics associated with sales. Each record in this view includes various identifiers such as sold date and time, ship date, customer IDs, and item details that facilitate comprehensive sales analysis. Key numerical fields such as quantities sold, prices, costs, discounts, and final amounts paid provide essential insights into sales performance, customer behavior, and profitability. This view also links to several demographic and logistical data points, enabling a holistic understanding of the sales landscape. This view can be utilized for in-depth sales analysis, tracking customer purchasing behavior, evaluating profitability, and assessing the effectiveness of marketing strategies.'
