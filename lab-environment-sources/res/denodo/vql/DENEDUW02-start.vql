        ca_address_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Represents a unique identifier for each address entry in the customer address database.'),
        ca_address_id:text (notnull, sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '16', description = 'Denotes a unique alphanumeric identifier for the address, with examples including "AAAAAAAAFEAAAAAA" and "AAAAAAAALAAAAAAA".'),
        ca_street_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the street number of the address, with samples like "189" and "809" showing typical entries.'),
        ca_street_name:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypesize = '60', description = 'Specifies the name of the street associated with the address, including examples such as "13th 2nd" and "Central ".'),
        ca_street_type:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '15', description = 'Identifies the type of street, with types including "Drive" and "Street" as examples.'),
        ca_suite_number:text (sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '10', description = 'Details any suite number associated with the address, with entries like "Suite 470" and "Suite H" as examples.'),
