        i_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Serves as the unique identifier for each item in the inventory, enabling efficient tracking and management.'),
        i_item_id:text (notnull, sourcetypeid = '1', sourcetyperadix = '10', sourcetypesize = '16', description = 'Represents the unique identifier assigned to each item, which may include values like "AAAAAAAAFCAAAAAA", "AAAAAAAANDAAAAAA", and "AAAAAAAAOCAAAAAA".'),
