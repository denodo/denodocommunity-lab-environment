        ws_ship_cdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique identifier for demographic data related to shipping customers, useful for targeted marketing.'),
        ws_ship_hdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the unique identifier for household demographics linked to shipping, aiding in consumer insights.'),
        ws_ship_addr_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Serves as the unique identifier for shipping addresses, which is vital for order fulfillment processes.'),
        ws_web_page_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the web page where the sales occurred, useful for analyzing the effectiveness of online platforms.'),
        ws_web_site_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique identifier for the website involved in the transactions, crucial for performance assessment of web sales channels.'),
        ws_ship_mode_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the unique identifier for the shipping method used, important for logistics and shipping cost analysis.'),
        ws_warehouse_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the warehouse from which the products were shipped, essential for inventory management and tracking.'),
        ws_promo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Serves as the unique identifier for promotional campaigns applied to sales, allowing for evaluation of marketing strategies.'),
        ws_order_number:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique number assigned to each order, facilitating order tracking and management.'),
        ws_quantity:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the quantity of products sold, providing insights into sales volume and inventory requirements.'),
        ws_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the cost incurred to acquire products at wholesale prices, important for profitability analysis.'),
        ws_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the standard price at which products are offered, crucial for pricing strategy assessments.'),
        ws_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the final selling price of the products, impacted by discounts and promotions, significant for revenue analysis.'),
        ws_ext_discount_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total amount of discounts applied to the sale, essential for understanding pricing strategies.'),
        ws_ext_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the aggregated sales price after all applicable discounts, critical for revenue calculations.'),
        ws_ext_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total cost incurred for items at wholesale rates, vital for determining overall cost structures.'),
        ws_ext_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total list price for all items in the transaction, useful for pricing strategy evaluations.'),
        ws_ext_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total tax applied to the transaction, essential for financial reporting and compliance.'),
        ws_coupon_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total amount deducted through coupons, important for understanding promotional impacts.'),
        ws_ext_ship_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total shipping costs incurred for the transaction, vital for logistical cost analysis.'),
        ws_net_paid:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the net amount paid by the customer after discounts, taxes, and shipping, crucial for profitability assessments.'),
