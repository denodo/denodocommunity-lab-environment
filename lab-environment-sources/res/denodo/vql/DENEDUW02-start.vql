# #######################################
# WEBSERVICES of denodo_hol
# #######################################
CREATE OR REPLACE REST WEBSERVICE customer_ws
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 90000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = HTML
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)
    RESOURCES (
        VIEW iv_customer FIELDS (
            customer_sk : 'int', 
            customer_id : 'text', 
            current_addr_sk : 'int', 
            first_name : 'text', 
            last_name : 'text', 
            preferred_cust_flag : 'text', 
            birth_day : 'int', 
            birth_month : 'int', 
            birth_year : 'int', 
            birth_country : 'text', 
            login : 'text', 
            email_address : 'text'
        ),
        VIEW iv_customer_j_address FIELDS (
            customer_sk : 'int', 
            customer_id : 'text', 
            current_addr_sk : 'int', 
            first_name : 'text', 
            last_name : 'text', 
            preferred_cust_flag : 'text', 
            birth_day : 'int', 
            birth_month : 'int', 
            birth_year : 'int', 
            birth_country : 'text', 
            login : 'text', 
            email_address : 'text', 
            address_sk : 'int', 
            address_id : 'text', 
            street_number : 'text', 
            street_name : 'text', 
            street_type : 'text', 
            city : 'text', 
            county : 'text', 
            state : 'text', 
            zip : 'text', 
            country : 'text'
        )
    )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/5 - data services';

CHOWN admin WEBSERVICE customer_ws LASTMODIFICATIONUSER admin;

CREATE OR REPLACE REST WEBSERVICE store_by_total_sales_ws
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 90000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = JSON
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)
    RESOURCES (
        VIEW store_by_total_sales FIELDS (
            store_sk : 'text', 
            total_sales : 'decimal'
        )
    )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/5 - data services';

CHOWN admin WEBSERVICE store_by_total_sales_ws LASTMODIFICATIONUSER admin;

# #######################################
# WEBCONTAINER WEB SERVICE DEPLOYMENTS of denodo_hol
# #######################################
UNDEPLOY IF EXISTS WEBSERVICE store_by_total_sales_ws;

DEPLOY WEBSERVICE store_by_total_sales_ws LOGIN = 'denodo' PASSWORD = 'denodo';

UNDEPLOY IF EXISTS WEBSERVICE customer_ws;

DEPLOY WEBSERVICE customer_ws LOGIN = 'denodo' PASSWORD = 'denodo';

# #######################################
# Closing connection with database denodo_hol
# #######################################
CLOSE;


