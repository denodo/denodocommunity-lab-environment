# #######################################
# WEBSERVICES of denodo_hol_dg_local
# #######################################
CREATE OR REPLACE REST WEBSERVICE customer_local_ws
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 90000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = HTML
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)
    RESOURCES (
        VIEW iv_customer FIELDS (
            customer_sk : 'int', 
            customer_id : 'text', 
            current_addr_sk : 'int', 
            first_name : 'text', 
            last_name : 'text', 
            preferred_cust_flag : 'text', 
            birth_day : 'int', 
            birth_month : 'int', 
            birth_year : 'int', 
            birth_country : 'text', 
            login : 'text', 
            email_address : 'text'
        ),
        VIEW iv_customer_j_address FIELDS (
            customer_sk : 'int', 
            customer_id : 'text', 
            current_addr_sk : 'int', 
            first_name : 'text', 
            last_name : 'text', 
            preferred_cust_flag : 'text', 
            birth_day : 'int', 
            birth_month : 'int', 
            birth_year : 'int', 
            birth_country : 'text', 
            login : 'text', 
            email_address : 'text', 
            address_sk : 'int', 
            address_id : 'text', 
            street_number : 'text', 
            street_name : 'text', 
            street_type : 'text', 
            city : 'text', 
            county : 'text', 
            state : 'text', 
            zip : 'text', 
            country : 'text'
        )
    )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/5 - data services';

CHOWN admin WEBSERVICE customer_local_ws LASTMODIFICATIONUSER admin;

CREATE OR REPLACE REST WEBSERVICE store_by_total_sales_local_ws
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 90000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = JSON
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)
    RESOURCES (
        VIEW store_by_total_sales FIELDS (
            store_sk : 'text', 
            total_sales : 'decimal'
        )
    )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/5 - data services';

CHOWN admin WEBSERVICE store_by_total_sales_local_ws LASTMODIFICATIONUSER admin;

# #######################################
# WEBCONTAINER WEB SERVICE DEPLOYMENTS of denodo_hol_dg_local
# #######################################
UNDEPLOY IF EXISTS WEBSERVICE store_by_total_sales_local_ws;

DEPLOY WEBSERVICE store_by_total_sales_local_ws LOGIN = 'denodo' PASSWORD = 'denodo';

UNDEPLOY IF EXISTS WEBSERVICE customer_local_ws;

DEPLOY WEBSERVICE customer_local_ws LOGIN = 'denodo' PASSWORD = 'denodo';

# #######################################
# Closing connection with database denodo_hol_dg_local
# #######################################
CLOSE;

# #######################################
# Connecting to database admin
# #######################################
CONNECT DATABASE ADMIN;

# #######################################
# USER PRIVILEGES
# #######################################

ALTER USER denodo
GRANT ROLE allusers,data_catalog_manager,data_catalog_assisted_query,data_catalog_classifier,data_catalog_editor,data_catalog_data_preparation,scheduler_admin,use_large_language_model
GRANT CONNECT ON admin
GRANT CONNECT, CREATE, CREATE_DATA_SOURCE, CREATE_DATA_SERVICE, CREATE_VIEW, CREATE_FOLDER, METADATA, EXECUTE ON denodo_hol
GRANT CONNECT ON denodo_hol_dg_local
GRANT METADATA ON DATASOURCE jdbc denodo_hol_dg_local.ds_tpcds_store
GRANT METADATA ON DATASOURCE jdbc denodo_hol_dg_local.ds_tpcds_sales
GRANT METADATA ON DATASOURCE jdbc denodo_hol_dg_local.ds_tpcds_warehouse
GRANT METADATA ON DATASOURCE jdbc denodo_hol_dg_local.ds_tpcds_customer;

ALTER USER reader
GRANT ROLE allusers
GRANT CONNECT ON admin
GRANT CONNECT ON denodo_hol
GRANT METADATA ON denodo_hol.iv_item
GRANT METADATA, EXECUTE ON denodo_hol.holiday_web_sales_by_year
GRANT METADATA, EXECUTE ON denodo_hol.same_store_sales_by_year
GRANT METADATA, EXECUTE ON denodo_hol.store_by_total_sales;

