CREATE OR REPLACE TABLE bv_store_sales I18N us_pst (
        ss_sold_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the date on which the sale occurred, providing a metric for tracking sales performance over time.'),
        ss_sold_time_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the specific time of day when the sale was made, allowing for analysis of peak sales periods.'),
        ss_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the specific item that was sold, essential for inventory management and sales reporting.'),
        ss_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to the customer who made the purchase, aiding in customer relationship management and targeted marketing.'),
        ss_cdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Relates to the customer demographic, providing insights into customer segments and preferences.'),
        ss_hdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Associates with household demographic information, useful for understanding household purchasing behaviors.'),
        ss_addr_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to the address of the customer, valuable for analyzing geographical sales trends and shipping logistics.'),
        ss_store_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Identifies the store where the sale occurred, critical for performance assessment of individual store locations.'),
        ss_promo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Links to promotional campaigns associated with the sale, enabling analysis of promotional effectiveness.'),
        ss_ticket_number:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Represents the unique identifier for each sales transaction, important for transaction tracking and audits.'),
        ss_quantity:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypesize = '10', description = 'Indicates the number of units sold in the transaction, essential for inventory control and sales volume assessment.'),
        ss_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the cost of the item from the supplier''s perspective, crucial for profit margin calculations.'),
        ss_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Denotes the original price of the item as listed, important for price strategy evaluations.'),
        ss_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the final selling price of the item after any discounts, key for revenue analysis.'),
        ss_ext_discount_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total amount discounted on the sale, important for financial reporting and discount strategy.'),
        ss_ext_sales_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the extended sales price for the transaction, including volumes sold, vital for revenue tracking.'),
        ss_ext_wholesale_cost:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Denotes the total cost incurred for the wholesale purchase, essential for cost management.'),
        ss_ext_list_price:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total list price for all items sold in the transaction, significant for sales analysis.'),
        ss_ext_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the total tax charged on the sale, crucial for financial compliance and revenue calculation.'),
        ss_coupon_amt:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total value of any coupons applied, important for analyzing promotional effectiveness.'),
        ss_net_paid:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the net amount paid by the customer after all deductions, vital for revenue calculations.'),
        ss_net_paid_inc_tax:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Represents the total amount paid including taxes, critical for financial reporting.'),
        ss_net_profit:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7', description = 'Indicates the profit made from the transaction after all expenses, essential for performance evaluation.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'The bv_store_sales view provides detailed information about sales transactions occurring at various store locations. It captures key aspects such as the date and time of sale, item identifiers, customer links, and financial details like sales price, discounts, and profits. Each transaction is uniquely identified by a ticket number, while additional fields provide insights into customer demographics and promotional activities. This comprehensive structure aids in tracking sales performance, understanding customer behavior, and assessing the effectiveness of marketing strategies. This view is essential for analyzing sales trends over time, evaluating store performance, and deriving insights for inventory management and customer relationship strategies.'
    CONSTRAINT 'PRIMARY' PRIMARY KEY ( 'ss_item_sk' , 'ss_ticket_number' )
    CACHE OFF
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_store_sales(
        I18N us_pst
        CONSTRAINTS (
             ADD ss_sold_date_sk (any) OPT ANY
             ADD ss_sold_time_sk (any) OPT ANY
             ADD ss_item_sk (any) OPT ANY
             ADD ss_customer_sk (any) OPT ANY
             ADD ss_cdemo_sk (any) OPT ANY
             ADD ss_hdemo_sk (any) OPT ANY
             ADD ss_addr_sk (any) OPT ANY
             ADD ss_store_sk (any) OPT ANY
             ADD ss_promo_sk (any) OPT ANY
             ADD ss_ticket_number (any) OPT ANY
             ADD ss_quantity (any) OPT ANY
             ADD ss_wholesale_cost (any) OPT ANY
             ADD ss_list_price (any) OPT ANY
             ADD ss_sales_price (any) OPT ANY
             ADD ss_ext_discount_amt (any) OPT ANY
             ADD ss_ext_sales_price (any) OPT ANY
             ADD ss_ext_wholesale_cost (any) OPT ANY
             ADD ss_ext_list_price (any) OPT ANY
             ADD ss_ext_tax (any) OPT ANY
             ADD ss_coupon_amt (any) OPT ANY
             ADD ss_net_paid (any) OPT ANY
             ADD ss_net_paid_inc_tax (any) OPT ANY
             ADD ss_net_profit (any) OPT ANY
        )
        OUTPUTLIST (ss_addr_sk, ss_cdemo_sk, ss_coupon_amt, ss_customer_sk, ss_ext_discount_amt, ss_ext_list_price, ss_ext_sales_price, ss_ext_tax, ss_ext_wholesale_cost, ss_hdemo_sk, ss_item_sk, ss_list_price, ss_net_paid, ss_net_paid_inc_tax, ss_net_profit, ss_promo_sk, ss_quantity, ss_sales_price, ss_sold_date_sk, ss_sold_time_sk, ss_store_sk, ss_ticket_number, ss_wholesale_cost
