CREATE OR REPLACE TABLE store_sales I18N es_euro (
        ss_sold_date_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_sold_time_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_item_sk:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_customer_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_cdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_hdemo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_addr_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_store_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_promo_sk:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_ticket_number:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_quantity:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        ss_wholesale_cost:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_list_price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_sales_price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_ext_discount_amt:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_ext_sales_price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_ext_wholesale_cost:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_ext_list_price:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_ext_tax:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_coupon_amt:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_net_paid:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_net_paid_inc_tax:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7'),
        ss_net_profit:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '7')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    CONSTRAINT 'store_sales_pkey' PRIMARY KEY ( 'ss_item_sk' , 'ss_ticket_number' )
    CACHE OFF
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD store_sales(
        I18N es_euro
        CONSTRAINTS (
             ADD ss_sold_date_sk (any) OPT ANY
             ADD ss_sold_time_sk (any) OPT ANY
             ADD ss_item_sk (any) OPT ANY
             ADD ss_customer_sk (any) OPT ANY
             ADD ss_cdemo_sk (any) OPT ANY
             ADD ss_hdemo_sk (any) OPT ANY
             ADD ss_addr_sk (any) OPT ANY
             ADD ss_store_sk (any) OPT ANY
             ADD ss_promo_sk (any) OPT ANY
             ADD ss_ticket_number (any) OPT ANY
             ADD ss_quantity (any) OPT ANY
             ADD ss_wholesale_cost (any) OPT ANY
             ADD ss_list_price (any) OPT ANY
             ADD ss_sales_price (any) OPT ANY
             ADD ss_ext_discount_amt (any) OPT ANY
             ADD ss_ext_sales_price (any) OPT ANY
             ADD ss_ext_wholesale_cost (any) OPT ANY
             ADD ss_ext_list_price (any) OPT ANY
             ADD ss_ext_tax (any) OPT ANY
             ADD ss_coupon_amt (any) OPT ANY
             ADD ss_net_paid (any) OPT ANY
             ADD ss_net_paid_inc_tax (any) OPT ANY
             ADD ss_net_profit (any) OPT ANY
        )
        OUTPUTLIST (ss_addr_sk, ss_cdemo_sk, ss_coupon_amt, ss_customer_sk, ss_ext_discount_amt, ss_ext_list_price, ss_ext_sales_price, ss_ext_tax, ss_ext_wholesale_cost, ss_hdemo_sk, ss_item_sk, ss_list_price, ss_net_paid, ss_net_paid_inc_tax, ss_net_profit, ss_promo_sk, ss_quantity, ss_sales_price, ss_sold_date_sk, ss_sold_time_sk, ss_store_sk, ss_ticket_number, ss_wholesale_cost
        )
        WRAPPER (jdbc store_sales)
    )
    SMART_ONLY;

# #######################################
# VIEWS of denodo_hol_cdi_local_solution
# #######################################
CREATE OR REPLACE VIEW customer_data FOLDER = '/2 - integration' (
    c_first_name TAGS (confidential),
    c_last_name TAGS (confidential),
    c_email_address TAGS (confidential)
 )
 AS SELECT customer.c_customer_sk AS c_customer_sk, customer.c_customer_id AS c_customer_id, customer.c_current_cdemo_sk AS c_current_cdemo_sk, customer.c_current_hdemo_sk AS c_current_hdemo_sk, customer.c_current_addr_sk AS c_current_addr_sk, customer.c_first_shipto_date_sk AS c_first_shipto_date_sk, customer.c_first_sales_date_sk AS c_first_sales_date_sk, customer.c_salutation AS c_salutation, customer.c_first_name AS c_first_name, customer.c_last_name AS c_last_name, customer.c_preferred_cust_flag AS c_preferred_cust_flag, customer.c_birth_day AS c_birth_day, customer.c_birth_month AS c_birth_month, customer.c_birth_year AS c_birth_year, customer.c_birth_country AS c_birth_country, customer.c_login AS c_login, customer.c_email_address AS c_email_address, customer.c_last_review_date AS c_last_review_date, customer_address.ca_address_sk AS ca_address_sk, customer_address.ca_address_id AS ca_address_id, customer_address.ca_street_number AS ca_street_number, customer_address.ca_street_name AS ca_street_name, customer_address.ca_street_type AS ca_street_type, customer_address.ca_suite_number AS ca_suite_number, customer_address.ca_city AS ca_city, customer_address.ca_county AS ca_county, customer_address.ca_state AS ca_state, customer_address.ca_zip AS ca_zip, customer_address.ca_country AS ca_country, customer_address.ca_gmt_offset AS ca_gmt_offset, customer_address.ca_location_type AS ca_location_type, customer_demographics.cd_demo_sk AS cd_demo_sk, customer_demographics.cd_gender AS cd_gender, customer_demographics.cd_marital_status AS cd_marital_status, customer_demographics.cd_education_status AS cd_education_status, customer_demographics.cd_purchase_estimate AS cd_purchase_estimate, customer_demographics.cd_credit_rating AS cd_credit_rating, customer_demographics.cd_dep_count AS cd_dep_count, customer_demographics.cd_dep_employed_count AS cd_dep_employed_count, customer_demographics.cd_dep_college_count AS cd_dep_college_count FROM (customer AS customer INNER JOIN customer_address AS customer_address ON customer.c_current_addr_sk = customer_address.ca_address_sk ) INNER JOIN customer_demographics AS customer_demographics ON customer.c_current_cdemo_sk = customer_demographics.cd_demo_sk ;

ALTER VIEW customer_data
 LAYOUT (customer = [20, 20, 200, 225], customer_address = [510, 200, 200, 225], customer_demographics = [860, 40, 200, 205]);

CREATE OR REPLACE VIEW sales_by_customer FOLDER = '/2 - integration' DESCRIPTION = 'The sales_by_customer view provides a comprehensive overview of customer sales data, including essential customer information such as first names, last names, email addresses, and associated country details. Specifically, it includes fields for the customer''s first and last names, which enhance personalization in customer interactions, alongside their email addresses for potential communication. The view also incorporates a unique customer identifier to streamline data management. Most importantly, it captures the total sales attributed to each customer, reflecting their purchasing behavior and overall contribution to sales. 
This view is designed to analyze customer purchasing behavior and aggregate sales data, facilitating targeted marketing efforts and personalized customer engagement.'  (
    ca_country (description = 'Represents the country associated with the customer, indicating their geographical location. It includes values like "United States".'),
    c_email_address (description = 'Captures the email address of customers for communication purposes. Currently, there are no sample values available.') TAGS (confidential),
    c_last_name (description = 'Details the last names of customers, providing insight into their identity. It includes values like "Garcia", "Gonzales", and "Phillips".') TAGS (confidential),
    c_first_name (description = 'Describes the first names of customers, which are essential for personalization in interactions. It includes values like "Albert", "Angel", and "Bernard".') TAGS (confidential),
    c_customer_sk (description = 'Serves as a unique identifier for each customer, facilitating data organization and retrieval.'),
    total_sales (description = 'Indicates the total sales amount attributed to each customer, reflecting their purchasing behavior.')
 )
 AS SELECT customer_data.ca_country AS ca_country, customer_data.c_email_address AS c_email_address, customer_data.c_last_name AS c_last_name, customer_data.c_first_name AS c_first_name, customer_data.c_customer_sk AS c_customer_sk, sum(store_sales.ss_sales_price) AS total_sales FROM store_sales AS store_sales INNER JOIN customer_data AS customer_data ON store_sales.ss_customer_sk = customer_data.c_customer_sk  GROUP BY customer_data.c_customer_sk, customer_data.c_first_name, customer_data.c_last_name, customer_data.c_email_address, customer_data.ca_country ORDER BY c_email_address ASC;

ALTER VIEW sales_by_customer
 LAYOUT (customer_data = [58, 17, 200, 200], store_sales = [333, 16, 200, 200]);

CREATE OR REPLACE VIEW report_sales_by_customer FOLDER = '/4 - report views' AS SELECT sales_by_customer.c_first_name AS c_first_name, sales_by_customer.c_last_name AS c_last_name, sales_by_customer.c_email_address AS c_email_address, sales_by_customer.c_customer_sk AS c_customer_sk, sales_by_customer.ca_country AS ca_country, sales_by_customer.total_sales AS total_sales FROM sales_by_customer;

ALTER VIEW report_sales_by_customer
 LAYOUT (sales_by_customer = [20, 20, 200, 200]);

ALTER VIEW report_sales_by_customer
 CACHE FULL
     BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE;

# #######################################
# ASSOCIATIONS
# #######################################
CREATE OR REPLACE ASSOCIATION customer_address_customer REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT customer customer_address PRINCIPAL (0,1)
    ENDPOINT customer_address customer (0,*)
    ADD MAPPING ca_address_sk=c_current_addr_sk;

CREATE OR REPLACE ASSOCIATION customer_demographics_customer REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT customer customer_demographics PRINCIPAL (0,1)
    ENDPOINT customer_demographics customer (0,*)
    ADD MAPPING cd_demo_sk=c_current_cdemo_sk;

CREATE OR REPLACE ASSOCIATION customer_sales_association REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT store_sales customer_data PRINCIPAL (1)
    ENDPOINT customer_data store_sales (0,*)
    ADD MAPPING c_customer_sk=ss_customer_sk;

ALTER ASSOCIATION customer_sales_association
 LAYOUT (customer_data = [0, 200, 200, 200], store_sales = [200, 200, 200, 200]);

# #######################################
# METRIC VIEWS
# #######################################
CREATE OR REPLACE METRIC VIEW customer_sales_metric
    FOLDER = '/3 - business entities and metrics'
    DESCRIPTION = 'The customer_sales_metric view is designed to encapsulate various metrics related to customer sales data. It includes essential fields such as customer keys, demographic information, sales dates, addresses, and overall sales performance. Key fields provide insights into customer identity, including customer IDs, names, and demographic details like gender, marital status, and education level. The view also captures sales-specific metrics, such as sold date, time, item information, and total sales amounts, thereby enabling a comprehensive analysis of customer purchase behavior and sales trends. This view can be utilized for analyzing customer purchasing patterns, understanding demographic influences on sales, and generating reports on sales performance across different customer segments.' 
     (
    c_customer_sk (description = 'Represents a unique identifier for each customer within the customer database, allowing for precise tracking of customer-related metrics.'),
    c_customer_id (description = 'Serves as an alternative identifier for customers, facilitating easier integration with other systems or datasets.'),
    c_current_cdemo_sk (description = 'Links to the current customer demographic information, providing insights into customer characteristics for analytical purposes.'),
    c_current_hdemo_sk (description = 'Refers to the current household demographic information, enabling understanding of household dynamics and purchasing behavior.'),
    c_current_addr_sk (description = 'Points to the current address of the customer, essential for geographic and postal analysis of customer behavior.'),
    c_first_shipto_date_sk (description = 'Indicates the date of the first shipment to the customer, marking the beginning of their purchasing history.'),
    c_first_sales_date_sk (description = 'Marks the date of the first sale made to the customer, providing a timeline reference for analyzing customer engagement.'),
    c_salutation (description = 'Contains the salutation for the customer, reflecting their preferred form of address and enhancing personalized communication.'),
    c_first_name (description = 'Represents the customer''s first name, essential for direct marketing efforts and personalized customer interactions.'),
    c_last_name (description = 'Holds the customer''s last name, crucial for identifying customers and tailoring communication strategies.'),
    c_preferred_cust_flag (description = 'Indicates whether the customer is identified as a preferred customer, guiding targeted marketing initiatives.'),
    c_birth_day (description = 'Reflects the customer''s birth day, useful for demographic analysis and personalized marketing efforts.'),
    c_birth_month (description = 'Indicates the customer''s birth month, allowing for targeted promotions and customer appreciation campaigns.'),
    c_birth_year (description = 'Contains the customer''s birth year, contributing to demographic profiling and age analysis.'),
    c_birth_country (description = 'Denotes the customer''s country of birth, providing insights into geographic distribution and cultural influences on purchasing behavior.'),
    c_login (description = 'Represents the customer''s online login identifier, crucial for tracking digital engagement and interaction with online services.'),
    c_email_address (description = 'Contains the customer''s email address, fundamental for digital communication and marketing outreach.'),
    c_last_review_date (description = 'Indicates the last date the customer reviewed a product or service, providing insights into customer engagement and feedback patterns.'),
    ca_address_sk (description = 'Links to the address record, supporting geographic and logistical analysis in customer sales metrics.'),
    ca_address_id (description = 'Serves as an alternative identifier for customer addresses, aiding in data integration and address tracking.'),
    ca_street_number (description = 'Indicates the street number of the customer''s address, essential for precise location identification.'),
    ca_street_name (description = 'Represents the name of the street where the customer resides, contributing to geographic analysis and logistics.'),
    ca_street_type (description = 'Denotes the type of street (e.g., avenue, road) of the customer''s address, providing additional context for location analysis.'),
    ca_suite_number (description = 'Specifies any suite number at the customer''s address, important for identifying specific locations within larger buildings.'),
    ca_city (description = 'Contains the city of the customer''s address, vital for regional marketing and demographic analysis.'),
    ca_county (description = 'Denotes the county of the customer''s address, contributing to geographic and demographic segmentation.'),
    ca_state (description = 'Represents the state of the customer''s address, relevant for regional sales analysis and marketing strategies.'),
    ca_zip (description = 'Indicates the postal code of the customer''s address, essential for geographic targeting in marketing campaigns.'),
    ca_country (description = 'Shows the country of the customer''s address, crucial for international sales analysis and cultural understanding.'),
    ca_location_type (description = 'Specifies the type of location (e.g., apartment, single family) for the customer, aiding in demographic analysis and market segmentation.'),
    cd_demo_sk (description = 'Links to the customer demographic record, providing insights into customer characteristics and preferences.'),
    cd_gender (description = 'Indicates the gender of the customer, important for demographic profiling and targeted marketing strategies.'),
    cd_marital_status (description = 'Denotes the marital status of the customer, contributing to demographic insights and targeted communication strategies.'),
    cd_education_status (description = 'Reflects the education level of the customer, useful for understanding demographic trends and tailoring marketing messages.'),
    cd_purchase_estimate (description = 'Indicates the estimated purchase potential of the customer, assisting in sales forecasting and marketing strategies.'),
    cd_credit_rating (description = 'Represents the customer''s credit rating, relevant for understanding purchasing behavior and risk assessment.'),
    cd_dep_count (description = 'Indicates the number of dependents of the customer, providing insights into household composition and potential purchasing power.'),
    cd_dep_employed_count (description = 'Denotes the number of employed dependents, contributing to understanding household income and spending capacity.'),
    cd_dep_college_count (description = 'Indicates the number of dependents attending college, useful for targeting education-related products and services.'),
    ss_sold_date_sk (description = 'Marks the date when a sale was made, crucial for analyzing sales trends over time and understanding customer behavior.'),
    ss_sold_time_sk (description = 'Indicates the time of the sale, assisting in temporal analysis of purchasing patterns and peak sales periods.'),
    ss_item_sk (description = 'Links to the specific item sold, essential for inventory management and product performance analysis.'),
    ss_customer_sk (description = 'References the customer involved in the sale, allowing for sales performance analysis of individual customers.'),
    ss_cdemo_sk (description = 'Links to the customer demographic information related to the sale, aiding in demographic analysis of purchasing patterns.'),
    ss_hdemo_sk (description = 'Refers to the household demographic data associated with the sale, providing insight into household purchasing behavior.'),
    ss_addr_sk (description = 'Links to the address associated with the sale, important for geographic sales analysis.'),
    ss_store_sk (description = 'Identifies the store where the sale took place, crucial for analyzing store performance and sales distribution.'),
    ss_promo_sk (description = 'Links to promotional details applicable to the sale, assisting in evaluating the effectiveness of marketing campaigns.'),
    ss_ticket_number (description = 'Represents the unique identifier for each transaction, essential for tracking individual sales records.'),
    ss_quantity (description = 'Indicates the quantity of items sold in the transaction, important for inventory control and sales performance analysis.'),
    customer_total_sales (description = 'Represents the total sales attributed to a customer, providing a comprehensive measure of customer value and purchasing behavior.')
 )
SOURCES (
        store_sales AS store_sales,
        customer_data AS customer_data    
    )
    ASSOCIATIONS (
        customer_data store_sales customer_sales_association    
    )
    DIMENSIONS (
        customer_data(
            c_customer_sk AS customer_data.c_customer_sk,
            c_customer_id AS customer_data.c_customer_id,
            c_current_cdemo_sk AS customer_data.c_current_cdemo_sk,
            c_current_hdemo_sk AS customer_data.c_current_hdemo_sk,
            c_current_addr_sk AS customer_data.c_current_addr_sk,
            c_first_shipto_date_sk AS customer_data.c_first_shipto_date_sk,
            c_first_sales_date_sk AS customer_data.c_first_sales_date_sk,
            c_salutation AS customer_data.c_salutation,
            c_first_name AS customer_data.c_first_name,
            c_last_name AS customer_data.c_last_name,
            c_preferred_cust_flag AS customer_data.c_preferred_cust_flag,
            c_birth_day AS customer_data.c_birth_day,
            c_birth_month AS customer_data.c_birth_month,
            c_birth_year AS customer_data.c_birth_year,
            c_birth_country AS customer_data.c_birth_country,
            c_login AS customer_data.c_login,
            c_email_address AS customer_data.c_email_address,
            c_last_review_date AS customer_data.c_last_review_date,
            ca_address_sk AS customer_data.ca_address_sk,
            ca_address_id AS customer_data.ca_address_id,
            ca_street_number AS customer_data.ca_street_number,
            ca_street_name AS customer_data.ca_street_name,
            ca_street_type AS customer_data.ca_street_type,
            ca_suite_number AS customer_data.ca_suite_number,
            ca_city AS customer_data.ca_city,
            ca_county AS customer_data.ca_county,
            ca_state AS customer_data.ca_state,
            ca_zip AS customer_data.ca_zip,
            ca_country AS customer_data.ca_country,
            ca_location_type AS customer_data.ca_location_type,
            cd_demo_sk AS customer_data.cd_demo_sk,
            cd_gender AS customer_data.cd_gender,
            cd_marital_status AS customer_data.cd_marital_status,
            cd_education_status AS customer_data.cd_education_status,
            cd_purchase_estimate AS customer_data.cd_purchase_estimate,
            cd_credit_rating AS customer_data.cd_credit_rating,
            cd_dep_count AS customer_data.cd_dep_count,
            cd_dep_employed_count AS customer_data.cd_dep_employed_count,
            cd_dep_college_count AS customer_data.cd_dep_college_count
        ),
        store_sales(
            ss_sold_date_sk AS store_sales.ss_sold_date_sk,
            ss_sold_time_sk AS store_sales.ss_sold_time_sk,
            ss_item_sk AS store_sales.ss_item_sk,
            ss_customer_sk AS store_sales.ss_customer_sk,
            ss_cdemo_sk AS store_sales.ss_cdemo_sk,
            ss_hdemo_sk AS store_sales.ss_hdemo_sk,
            ss_addr_sk AS store_sales.ss_addr_sk,
            ss_store_sk AS store_sales.ss_store_sk,
            ss_promo_sk AS store_sales.ss_promo_sk,
            ss_ticket_number AS store_sales.ss_ticket_number,
            ss_quantity AS store_sales.ss_quantity
        )    
    )
    METRICS (
        customer_total_sales AS sum(store_sales.ss_sales_price)    
    )
;

ALTER VIEW customer_sales_metric
 LAYOUT (customer_data = [76, 37, 40, 80], store_sales = [478, 39, 40, 80]);

