# #######################################
# POLICY CREATION
# #######################################
CREATE OR REPLACE GLOBAL_SECURITY_POLICY mask_confidential_data
    ENABLED = TRUE
    AUDIENCE (
        ANY ROLES (analyst)
    )
    ELEMENTS (
        ALL VIEWS
    )
    RESTRICTION (
        FILTER = ''
        MASKING ANY (confidential) WITH (HIDE) (numbers WITH DEFAULT, datetimes WITH DEFAULT, texts WITH DEFAULT) 
    );

CHOWN denodo GLOBAL_SECURITY_POLICY mask_confidential_data LASTMODIFICATIONUSER denodo;

